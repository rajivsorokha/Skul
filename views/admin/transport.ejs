<%- include('../partials/header') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-extrabold">Transportation</h1>
    <p class="text-sm text-soft mt-0.5">Bus routes, drivers, and student assignments.</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <% routes.forEach(r => { %>
    <div class="surface rounded-2xl p-5">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white text-lg flex-shrink-0" style="background:#64748B"><i class="fa-solid fa-bus"></i></div>
        <div>
          <div class="font-extrabold text-base"><%= r.route_name %></div>
          <div class="text-xs text-soft mt-0.5">Bus No. <%= r.bus_no %></div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 text-sm mb-3">
        <div class="surface-2 rounded-xl p-3">
          <div class="text-[10px] uppercase font-bold text-soft">Pickup</div>
          <div class="font-bold mt-0.5"><%= r.pickup_time %></div>
        </div>
        <div class="surface-2 rounded-xl p-3">
          <div class="text-[10px] uppercase font-bold text-soft">Drop</div>
          <div class="font-bold mt-0.5"><%= r.drop_time %></div>
        </div>
      </div>
      <div class="flex items-center justify-between text-sm border-t border-app pt-3">
        <div><span class="text-soft">Driver:</span> <span class="font-bold"><%= r.driver_name || 'Unassigned' %></span></div>
        <div class="font-mono text-soft text-xs"><%= r.driver_phone || '' %></div>
      </div>
      <div class="text-xs text-soft mt-2"><%= r.studentCount %> students assigned to this route</div>
    </div>
  <% }) %>
  <% if (routes.length === 0) { %>
    <div class="surface rounded-2xl p-8 text-center text-sm text-soft col-span-2">No bus routes set up yet.</div>
  <% } %>
</div>

<%- include('../partials/footer') %>
