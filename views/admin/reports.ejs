<%- include('../partials/header') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-extrabold">Reports & Exports</h1>
    <p class="text-sm text-soft mt-0.5">Download data as CSV for offline use or reporting to the board.</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="surface rounded-2xl p-5">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white text-lg mb-3" style="background:#8B5CF6"><i class="fa-solid fa-users"></i></div>
    <div class="font-extrabold text-sm mb-1">Student Directory</div>
    <div class="text-xs text-soft mb-4 leading-relaxed">Name, roll number, class, and parent contact for every student.</div>
    <a href="/admin/reports/export/students" class="btn btn-primary w-full justify-center"><i class="fa-solid fa-download"></i>Download CSV</a>
  </div>
  <div class="surface rounded-2xl p-5">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white text-lg mb-3" style="background:#12A883"><i class="fa-solid fa-indian-rupee-sign"></i></div>
    <div class="font-extrabold text-sm mb-1">Fee Report</div>
    <div class="text-xs text-soft mb-4 leading-relaxed">Every fee record with amount, status, and due date.</div>
    <a href="/admin/reports/export/fees" class="btn btn-primary w-full justify-center"><i class="fa-solid fa-download"></i>Download CSV</a>
  </div>
  <div class="surface rounded-2xl p-5">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white text-lg mb-3" style="background:#E8609C"><i class="fa-solid fa-calendar-check"></i></div>
    <div class="font-extrabold text-sm mb-1">Attendance Log</div>
    <div class="text-xs text-soft mb-4 leading-relaxed">Full daily attendance history across all students.</div>
    <a href="/admin/reports/export/attendance" class="btn btn-primary w-full justify-center"><i class="fa-solid fa-download"></i>Download CSV</a>
  </div>
</div>

<%- include('../partials/footer') %>
