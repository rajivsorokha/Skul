<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ST. JOSEPH'S CHANDEL — Records Office</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<script>
  tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter','sans-serif'], mono: ["'IBM Plex Mono'",'monospace'] } } } }
</script>
<style>
  body{ background:#0b0f14; font-family:'Inter',sans-serif; }
  ::-webkit-scrollbar{ width:8px; height:8px; }
  ::-webkit-scrollbar-thumb{ background:#2c313b; border-radius:4px; }
  .surface{ background:#151a21; }
  .surface-2{ background:#1d232c; }
  .border-app{ border-color:#262d38; }
  .text-soft{ color:#98a1ad; }
  .nav-link{ display:flex; align-items:center; gap:12px; padding:10px 14px; border-radius:12px; color:#98a1ad; font-weight:600; font-size:13.5px; transition:background .12s, color .12s; }
  .nav-link:hover{ background:#1d232c; color:#f2f5f9; }
  .nav-link.active{ background:#0FA3A3; color:#04181a; }
  table.data th{ text-align:left; font-size:10.5px; text-transform:uppercase; letter-spacing:0.04em; color:#98a1ad; padding:10px 14px; border-bottom:1px solid #262d38; }
  table.data td{ padding:12px 14px; font-size:13.5px; color:#f2f5f9; border-bottom:1px solid #1d232c; }
  table.data tr:last-child td{ border-bottom:none; }
  .btn{ font-weight:700; font-size:13px; padding:9px 16px; border-radius:10px; display:inline-flex; align-items:center; gap:6px; cursor:pointer; border:none; }
  .btn-primary{ background:#0FA3A3; color:#04181a; }
  .btn-primary:hover{ background:#0d8f8f; }
  .btn-green{ background:#3FB87F; color:#052e1b; }
  .btn-red{ background:#E8609C; color:#fff; }
  .btn-ghost{ background:#1d232c; color:#f2f5f9; }
  .btn-ghost:hover{ background:#262d38; }
  input, select, textarea{ background:#1d232c; border:1.5px solid #262d38; color:#f2f5f9; border-radius:10px; padding:9px 12px; font-size:13.5px; }
  input:focus, select:focus, textarea:focus{ outline:2px solid #0FA3A3; border-color:transparent; }
  .chip{ font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.03em; padding:4px 10px; border-radius:999px; display:inline-block; }
  .tab-link{ padding:8px 16px; border-radius:10px; font-size:13px; font-weight:700; color:#98a1ad; }
  .tab-link.active{ background:#0FA3A3; color:#04181a; }
  .sec-tab{ padding:9px 14px; border-radius:10px; font-size:12.5px; font-weight:700; color:#98a1ad; cursor:pointer; border:1.5px solid #262d38; }
  .sec-tab.active{ background:#0FA3A3; color:#04181a; border-color:transparent; }
  .sec-panel{ display:none; }
  .sec-panel.active{ display:block; }
  @media print{ .no-print{ display:none !important; } }
</style>
</head>
<body class="text-[#f2f5f9]">
<div class="flex min-h-screen">

  <aside class="w-64 surface border-r border-app flex-shrink-0 flex flex-col p-4 sticky top-0 h-screen">
    <div class="flex items-center gap-2.5 px-2 py-3 mb-4">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:#0FA3A3"><i class="fa-solid fa-folder-open text-[#04181a]"></i></div>
      <div>
        <div class="font-extrabold text-sm leading-tight">ST. JOSEPH'S CHANDEL</div>
        <div class="text-[10px] font-bold uppercase tracking-widest text-soft">Records Office</div>
      </div>
    </div>
    <nav class="space-y-1 flex-1">
      <a href="/local-admin" class="nav-link <%= active==='dashboard'?'active':'' %>"><i class="fa-solid fa-gauge w-4"></i>Overview</a>
      <a href="/local-admin/students" class="nav-link <%= active==='students'?'active':'' %>"><i class="fa-solid fa-address-book w-4"></i>Student Register</a>
      <a href="/local-admin/students/new" class="nav-link <%= active==='new'?'active':'' %>"><i class="fa-solid fa-user-plus w-4"></i>New Student Record</a>
      <a href="/local-admin/reports" class="nav-link <%= active==='reports'?'active':'' %>"><i class="fa-solid fa-chart-column w-4"></i>Reports</a>

      <div class="pt-3 mt-2 border-t border-app">
        <div class="px-3 pb-1 text-[10px] font-extrabold uppercase tracking-widest text-soft">On-premise panel</div>
        <div class="px-3 text-[11px] leading-relaxed text-soft">Local records office tool. Not connected to the mobile app API.</div>
        <a href="/" class="nav-link mt-2"><i class="fa-solid fa-arrow-up-right-from-square w-4"></i>Main Portal</a>
      </div>
    </nav>
    <div class="pt-3 border-t border-app">
      <div class="flex items-center gap-3 px-2 py-2">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-[#04181a] font-bold text-xs flex-shrink-0" style="background:#0FA3A3"><%= user.name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase() %></div>
        <div class="min-w-0">
          <div class="font-bold text-xs truncate"><%= user.name %></div>
          <div class="text-[10px] text-soft uppercase font-bold">Records Admin</div>
        </div>
      </div>
      <form method="POST" action="/local-admin/logout" class="mt-1">
        <button class="nav-link w-full text-left" style="color:#E8609C"><i class="fa-solid fa-right-from-bracket w-4"></i>Logout</button>
      </form>
    </div>
  </aside>

  <main class="flex-1 min-w-0 p-8">
