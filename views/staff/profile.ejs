<%- include('../partials/staff-header') %>

<div class="flex flex-col items-center py-4 pb-8">
  <div class="w-20 h-20 rounded-full flex items-center justify-center text-white font-extrabold text-2xl mb-3" style="background:linear-gradient(135deg,#64748B,#2C3444);"><%= initials(staff.name) %></div>
  <div class="font-extrabold text-lg"><%= staff.name %></div>
  <div class="text-sm text-soft mt-0.5"><%= staff.designation %> · <%= staff.department %></div>
</div>

<div class="max-w-md mx-auto surface rounded-2xl p-5">
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Employee ID</span><span class="font-bold"><%= staff.employee_id %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Department</span><span class="font-bold"><%= staff.department %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Designation</span><span class="font-bold"><%= staff.designation %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Email</span><span class="font-bold"><%= staff.email %></span></div>
  <div class="flex justify-between py-2.5 text-sm"><span class="text-soft">Phone</span><span class="font-bold"><%= staff.phone || '—' %></span></div>
</div>

<%- include('../partials/footer') %>
