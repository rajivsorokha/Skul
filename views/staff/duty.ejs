<%- include('../partials/staff-header') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-extrabold">Duty Schedule</h1>
    <p class="text-sm text-soft mt-0.5">Your weekly duty roster.</p>
  </div>
</div>

<% if (todayDuty) { %>
<div class="rounded-2xl p-5 mb-6 text-white" style="background:linear-gradient(135deg,#FFC93C,#e0a90a);">
  <div class="text-xs font-bold uppercase tracking-wide" style="color:#5c4a00">Today's Duty</div>
  <div class="font-extrabold text-lg mt-1" style="color:#2b2200"><%= todayDuty.shift_label %> · <%= todayDuty.post %></div>
  <div class="text-xs mt-1" style="color:#5c4a00"><%= todayDuty.time_range %></div>
</div>
<% } %>

<div class="space-y-2.5">
  <% if (rows.length === 0) { %>
    <div class="surface rounded-2xl p-8 text-center text-sm text-soft">No duty roster has been set up for you yet.</div>
  <% } %>
  <% rows.forEach(d => { %>
    <div class="surface rounded-2xl p-4 flex items-center gap-4" <% if (d.day === todayName) { %>style="border-left:4px solid #FFC93C"<% } %>>
      <div class="w-16 flex-shrink-0"><div class="font-bold text-sm"><%= d.day %></div></div>
      <div class="flex-1"><div class="font-bold text-sm"><%= d.shift_label %> <% if (d.time_range && d.time_range !== '—') { %>· <%= d.time_range %><% } %></div><div class="text-xs text-soft mt-0.5"><%= d.post %></div></div>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
