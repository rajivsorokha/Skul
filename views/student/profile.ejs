<%- include('../partials/student-header') %>

<div class="flex flex-col items-center py-4 pb-8">
  <div class="w-20 h-20 rounded-full flex items-center justify-center text-white font-extrabold text-2xl mb-3" style="background:linear-gradient(135deg,#FB7B4F,#FFC93C);"><%= initials(student.name) %></div>
  <div class="font-extrabold text-lg"><%= student.name %></div>
  <div class="text-sm text-soft mt-0.5">Class <%= student.class_name %> · Roll No. <%= student.roll_no %></div>
</div>

<div class="max-w-md mx-auto surface rounded-2xl p-5">
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Date of Birth</span><span class="font-bold"><%= student.dob || '—' %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Blood Group</span><span class="font-bold"><%= student.blood_group || '—' %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Parent Name</span><span class="font-bold"><%= student.parent_name || '—' %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Parent Contact</span><span class="font-bold"><%= student.parent_phone || '—' %></span></div>
  <div class="flex justify-between py-2.5 text-sm border-b border-app"><span class="text-soft">Email</span><span class="font-bold"><%= student.email %></span></div>
  <div class="flex justify-between py-2.5 text-sm"><span class="text-soft">Bus Route</span><span class="font-bold"><%= student.bus_route || '—' %></span></div>
</div>

<%- include('../partials/footer') %>
