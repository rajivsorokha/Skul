<%- include('../partials/student-header') %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-extrabold">Homework</h1>
    <p class="text-sm text-soft mt-0.5">Assignments posted for your class.</p>
  </div>
</div>

<div class="space-y-2.5">
  <% if (rows.length === 0) { %>
    <div class="surface rounded-2xl p-8 text-center text-sm text-soft">No homework posted yet.</div>
  <% } %>
  <% rows.forEach(h => { %>
    <div class="surface rounded-2xl p-4 flex items-center gap-4">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white flex-shrink-0" style="background:#3FB87F"><i class="fa-solid fa-book text-sm"></i></div>
      <div class="flex-1"><div class="font-bold text-sm"><%= h.title %></div><div class="text-xs text-soft mt-1"><%= h.subject %><% if (h.due_date) { %> · Due <%= h.due_date %><% } %></div></div>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
